# -------------------- ENVIRONMENT CONFIGURATION -------------------- #
# Application
NODE_ENV=development
PORT=3000

# Mock AI Model Service
MODEL_SERVICE_URL=http://localhost:4001

# Resilience Strategies
ENABLE_TIMEOUT=true
ENABLE_RETRIES=true
ENABLE_CIRCUIT_BREAKER=true

# Timeout
MODEL_SERVICE_TIMEOUT_MS=2000

# Retries
MAX_MODEL_RETRIES=2
RETRY_DELAY_MS=250

# Circuit Breaker
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_TIMEOUT_MS=10000